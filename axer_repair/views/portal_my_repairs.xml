<odoo>
    <template id="portal_my_repairs" name="My Repairs">
      <link rel="stylesheet" href="/axer_repair/static/css/table2.css"/>
        <t t-call="portal.portal_layout">
            <div class="container">
                <h1>Tus equipos</h1>
            <div class="table-responsive">
                <table class="table table-striped">
                  <thead class="thead-light">
                        <tr>
                            <th>Entrada</th>
                            <th class="col-6 col-md-8">Device</th>
                            <th>Descripcion</th>
                            <!-- <th>Status</th> -->
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="repairs" t-as="repair">
                            <tr>
                                <td>
                                    <a t-attf-href="/my/repair/#{repair.id}">
                                        <t t-out="repair.name"/> <br></br>
                                        <div t-att-class="'state ' + 'state-' + repair.state">
                                        <t t-out="repair.state"/>
                                        </div>
                                    </a>
                                </td>
                                <td>
                                    <t t-out="repair.product_id.name"/>
                                </td>
                                <td>
                                    <t t-out="repair.description"/>
                                </td>
                                <!-- <td>
                                    <t t-out="repair.state"/>
                                </td> -->
                            </tr>
                        </t>
                    </tbody>
                </table>
                <t t-call="portal.pager" t-vars="pager=pager"/>
            </div>
            </div>
        </t>
    </template>

