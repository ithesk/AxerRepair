<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de árbol (lista) -->
    <record id="view_repair_location_tree" model="ir.ui.view">
        <field name="name">repair.location.tree</field>
        <field name="model">repair.location</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="address"/>
                <field name="phone"/>
                <field name="printer_name"/>
                <field name="printer_ip"/>
                <field name="active"/>
                <field name="cups_server_ip"/>
                <field name="printer_name"/>
                <field name="receipt_printer_name"/>

            </tree>
        </field>
    </record>

    <!-- Vista de formulario -->
    <record id="view_repair_location_form" model="ir.ui.view">
        <field name="name">repair.location.form</field>
        <field name="model">repair.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" placeholder="Branch name"/>
                            <field name="address"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="printer_name"/>
                            <field name="printer_ip"/>
                            <field name="active"/>
                            <field name="cups_server_ip"/>
                            <field name="receipt_printer_name"/>
                        </group>
                    </group>
                    <separator string="Additional intake fields"/>
                    <p class="text-muted">
                        This branch can record extra fields on every device it
                        takes in — for instance a checkbox, a dropdown or a date.
                        You add them from any repair: open its
                        <b>Device intake</b> tab and use <b>Add a Property</b> at
                        the bottom. Once created they apply to every repair booked
                        at this branch, with no need to change any code.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_repair_location" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">repair.location</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Elemento de menú -->
    <menuitem id="menu_repair_location"
              name="Branches"
              parent="repair.menu_repair_order"
              action="action_repair_location"
              sequence="20"/>
</odoo>