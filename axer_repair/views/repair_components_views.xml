<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de lista para componentes -->
    <record id="view_repair_component_tree" model="ir.ui.view">
        <field name="name">repair.component.tree</field>
        <field name="model">repair.component</field>
        <field name="arch" type="xml">
            <list string="Repair components" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario para componentes -->
    <record id="view_repair_component_form" model="ir.ui.view">
        <field name="name">repair.component.form</field>
        <field name="model">repair.component</field>
        <field name="arch" type="xml">
            <form string="Repair component">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="category"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción para gestionar componentes -->
    <record id="action_repair_component" model="ir.actions.act_window">
        <field name="name">Repair components</field>
        <field name="res_model">repair.component</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first repair component
            </p>
            <p>
                Los componentes ayudan a los técnicos a registrar exactamente qué se reparó.
            </p>
        </field>
    </record>

    <!-- Bajo el menú de configuración de Odoo -->
    <menuitem
        id="menu_repair_components"
        name="Repair components"
        parent="repair.repair_menu_config"
        action="action_repair_component"
        sequence="30"/>

</odoo>